@page "/invoices"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using eshop.Data.Entities
@using eshop.Components.Pages.invoice_components
@inject IInvoiceServices _invoiceService
<h1>Invoices</h1>

<MudTable Items="Invo" Dense="@dense" Hover="@hover" Bordered="@bordered" Striped="@striped" >

    <ToolBarContent>
        <MudText Typo="Typo.h6">Invoices Sheet</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" @onclick="NavigateToAddInvoice">
            Add Invoice
        </MudButton>
    </ToolBarContent>

    <LoadingContent>
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
    </LoadingContent>

    <HeaderContent>
        <MudTh>Invoice Id</MudTh>
        <MudTh>Customer Name</MudTh>
        <MudTh>Customer Id</MudTh>
        <MudTh>Customer Email</MudTh>
        <MudTh>Operations</MudTh>


    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Invoice Id">@context.Id</MudTd>
        <MudTd DataLabel="Customer Name">@context.Customer?.CustomerName</MudTd>
        <MudTd DataLabel="Customer Id">@context.CustomerId</MudTd>
        <MudTd DataLabel="Customer Email">@context.Customer?.CustomerEmail</MudTd>
        <MudTd DataLabel="Operations">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" OnClick="()=>NavigateToAddInvoice(context)" />
            <MudButton Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" OnClick="()=>DeleteInvoice(context)"/>

        </MudTd>


    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

<div class="d-flex flex-wrap mt-4">
    <MudSwitch @bind-Value="hover" Color="Color.Primary">Hover</MudSwitch>
    <MudSwitch @bind-Value="dense" Color="Color.Secondary">Dense</MudSwitch>
    <MudSwitch @bind-Value="striped" Color="Color.Tertiary">Striped</MudSwitch>
    <MudSwitch @bind-Value="bordered" Color="Color.Warning">Bordered</MudSwitch>
    <MudSpacer />
    <div style="min-width:200px;">
        <MudText Class="align-self-center d-inline">Selected1</MudText>
    </div>
</div>
@code {
    private bool dense = false;
    private bool hover = true;
    private bool striped = false;
    private bool bordered = false;
    private string searchString1 = "";

    public List<Invoice> Invo { get; set; } = new List<Invoice>();

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1000);
        Invo = await _invoiceService.GetInvoices();
    }

    public void NavigateToAddInvoice()
    {
        NavigationManager.NavigateTo("/invoicesedit");
    }

    public void NavigateToAddInvoice(Invoice invoice)
    {
        NavigationManager.NavigateTo($"/invoicesedit/{invoice.Id}");
    }

    public async Task DeleteInvoice(Invoice invoice)
    {
        await _invoiceService.DeleteAsync(invoice);
        Invo.Remove(invoice);
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
        Snackbar.Add("Invoice deleted successfully", Severity.Success);

    }
}
