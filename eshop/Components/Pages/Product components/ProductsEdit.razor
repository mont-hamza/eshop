@page "/productsedit"
@page "/productsedit/{Id:guid}"
@rendermode InteractiveServer
@using eshop.Data.Entities
@using eshop.Components.Pages.Product_components
@inject IProductServices _productService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<h3>@(Id == Guid.Empty ? "Add Product" : "Edit Product")</h3>
<EditForm Model="product" OnValidSubmit="HandleValidSubmit">
    <MudTextField @bind-Value="product.Name" Label="Name" Required="true" />
    <MudTextField @bind-Value="product.Description" Label="Description" />
    <MudTextField @bind-Value="product.Category" Label="Category" />
    <MudTextField @bind-Value="product.Price" Label="Price" InputType="InputType.Number" />
    <MudTextField @bind-Value="product.StockQuantity" Label="Stock Quantity" InputType="InputType.Number" />

    <InputFile OnChange="OnImageSelected" />
    @if (!string.IsNullOrEmpty(product.ImageUrl))
    {
        <img src="@product.ImageUrl" alt="Product Image" style="max-width:200px;max-height:200px;" />
    }
    <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
    <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="GoBack">Cancel</MudButton>
</EditForm>

@code {
    [Parameter] public Guid? Id { get; set; }
    private Product product = new();
    private string? imageUploadError;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue && Id.Value != Guid.Empty)
        {
            var existing = await _productService.GetProductById(Id.Value);
            if (existing != null)
                product = existing;
        }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            var fileName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
            var filePath = Path.Combine("images", "products", fileName);
            var absolutePath = Path.Combine(Environment.CurrentDirectory, "wwwroot", filePath);

            Directory.CreateDirectory(Path.GetDirectoryName(absolutePath)!);

            using var stream = File.Create(absolutePath);
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(stream);

            product.ImageUrl = "/" + filePath.Replace("\\", "/");
            imageUploadError = null;
        }
        catch (Exception ex)
        {
            imageUploadError = $"Image upload failed: {ex.Message}";
            Snackbar.Add(imageUploadError, Severity.Error);
        }
    }

    private async Task HandleValidSubmit()
    {
        if (Id.HasValue && Id.Value != Guid.Empty)
            await _productService.UpdateProduct(product);
        else
        {
            product.Id = Guid.NewGuid();
            await _productService.AddProduct(product);
        }

        Snackbar.Add("Product saved successfully!", Severity.Success);
        NavigationManager.NavigateTo("/browse");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/browse");
    }
}
