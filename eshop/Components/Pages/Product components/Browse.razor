@page "/browse"
@rendermode InteractiveServer
@using eshop.Data.Entities
@using eshop.Components.Pages.Product_components
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IProductServices _productService

<h3>Browse Products</h3>
<MudButton Color="Color.Dark" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" @onclick="NavigateToAddProduct">
    Add Product
</MudButton>
@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
}
else
{
    <MudGrid Spacing="3" Justify="Justify.FlexStart">
        @foreach (var context in products)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="8">
                    <MudCardMedia Image="@context.ImageUrl" Height="150" />
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@context.Name</MudText>
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary">@($"${context.Price:F2}")</MudText>
                        <MudText>@context.Description</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Category: @context.Category</MudText>
                        <MudText Typo="Typo.caption">Stock: @(context.StockQuantity ?? 0)</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Default" @onclick="() => NavigateToEditProduct(context)">Edit</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" @onclick="() => DeleteConfirmed(context)">Remove</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<MudDialog @bind-IsOpen="_deleteDialogOpen">
    <DialogContent>
        <MudText Typo="Typo.h6">Are you sure you want to delete this product?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" @OnClick="() => DeleteConfirmed(context)">Delete</MudButton>
        <MudButton OnClick="() => _deleteDialogOpen = false">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Product> products = new();
    private bool _loading = true;
    private bool _deleteDialogOpen = false;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            products = await _productService.GetProducts();
        }
        catch (Exception ex)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add($"Error loading products: {ex.Message}", Severity.Error);
        }
        _loading = false;
    }

    private void NavigateToEditProduct(Product product)
    {
        if (product == null) return;
        NavigationManager.NavigateTo($"/productsedit/{product.Id}");
    }
    private void NavigateToAddProduct()
    {
        NavigationManager.NavigateTo("/productsedit");
    }

    private async Task DeleteConfirmed(Product product)
    {
        await _productService.DeleteProduct(product);
        products.Remove(product);
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
        Snackbar.Add("Product deleted successfully!", Severity.Success);
    }
}
