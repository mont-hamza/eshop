
    @rendermode InteractiveServer  
    @using eshop.Components.Pages  
    @using eshop.Data.Entities  
    @inject NavigationManager NavigationManager  
    @inject ISnackbar Snackbar  
    @inject IDialogService DialogService  
    @inherits LayoutComponentBase  
    @using MudBlazor  
    @using eshop.Components.Pages.Product_components  

    @page "/"  

    <PageTitle>Verona Shop - Home</PageTitle>  

    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">  

        <!-- Welcome/Introductory Section -->  
        <MudPaper Class="pa-6 mb-8" Elevation="2">  
            <MudText Typo="Typo.h3" Color="Color.Primary" GutterBottom="true">  
                Welcome to Verona Shop!  
            </MudText>  
            <MudText Typo="Typo.subtitle1">  
                Discover the best deals and latest trends in our exclusive online store. We’re delighted to have you here!  
            </MudText>  
        </MudPaper>  

        <!-- Product Preview Section -->  
        <MudPaper Class="pa-6 mb-8" Elevation="1">  
            <MudText Typo="Typo.h5" GutterBottom="true">Featured Products</MudText>  
            <MudCarousel TData="object">  
                <!-- Example product previews; replace with dynamic content as needed -->  
                <MudCarouselItem>  
                    <MudCard>  
                        <MudCardMedia Image="images/product1.jpg" Height="140" />  
                        <MudCardContent>  
                            <MudText Typo="Typo.subtitle2">Product 1</MudText>  
                            <MudText Typo="Typo.body2">Short description of product 1.</MudText>  
                        </MudCardContent>  
                    </MudCard>  
                </MudCarouselItem>  
                <MudCarouselItem>  
                    <MudCard>  
                        <MudCardMedia Image="images/product2.jpg" Height="140" />  
                        <MudCardContent>  
                            <MudText Typo="Typo.subtitle2">Product 2</MudText>  
                            <MudText Typo="Typo.body2">Short description of product 2.</MudText>  
                        </MudCardContent>  
                    </MudCard>  
                </MudCarouselItem>  
                <!-- Add more products as needed -->  
            </MudCarousel>  
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/browse">  
                Browse All Products  
            </MudButton>  
        </MudPaper>  

        <!-- Login/Sign Up Section -->  
        <MudPaper Class="pa-6 mb-8" Elevation="1">  
            <MudText Typo="Typo.h5" GutterBottom="true">Sign In or Create an Account</MudText>  
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mr-2" Href="/login">  
                Login  
            </MudButton>  
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/register">  
                Sign Up  
            </MudButton>  
        </MudPaper>  

        <!-- Contacts Section -->  
        <MudPaper Class="pa-6" Elevation="1">  
            <MudText Typo="Typo.h5" GutterBottom="true">Contact Us</MudText>  
            <MudText Typo="Typo.body2">  
                Have questions or need support? Reach out to us!  
            </MudText>  
            <MudList T="string">  
                <MudListItem>  
                    <MudListItemIcon>  
                        <MudIcon Icon="@Icons.Material.Filled.Email" />  
                    </MudListItemIcon>  
                    <MudListItemText>Email: <MudLink Href="mailto:support@veronashop.com">support@veronashop.com</MudLink></MudListItemText>  
                </MudListItem>  
                <MudListItem>  
                    <MudListItemIcon>  
                        <MudIcon Icon="@Icons.Material.Filled.Phone" />  
                    </MudListItemIcon>  
                    <MudListItemText>Phone: +1 (555) 123-4567</MudListItemText>  
                </MudListItem>  
            </MudList>  
        </MudPaper>  
    </MudContainer>