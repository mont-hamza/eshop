@page "/customersedit"
@page "/customersedit/{Id:Guid}"
@using eshop.Data.Entities
@using eshop.Components.Pages.customer_components
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
<h3>CustomerEdit</h3>

<MudTextField @bind-Value="Customer.CustomerName" Label="Customer Name" />
<MudTextField @bind-Value="Customer.Id" Label="Customer Identifiction" />
<MudButton Color="Color.Primary" Variant="Variant.Filled"  @onclick="SaveCustomer" >Save</MudButton>
<MudButton Color="Color.Secondary" Variant="Variant.Filled" @onclick="navigateback">Back</MudButton>


@code {

    [Parameter]
    public Guid Id { get; set; }

    private Customer Customer { get; set; } = new Customer();

    protected override async Task OnInitializedAsync()
    {

        await Task.Delay(1000);
        Customer = new Customer
        {
                Id = Guid.NewGuid(),
                CustomerName = "John Doe",
        };

    }

    private async Task SaveCustomer()
    {
        await Task.Delay(1000);
        Console.WriteLine($"Saved Customer: {Customer.CustomerName} {Customer.Id}");
    }

    private async Task navigateback()
    {
        await Task.Delay(1000);
        NavigationManager.NavigateTo("/customers");
    }
}
