@page "/customersedit"
@page "/customersedit/{CustomerId:Guid}"
@using eshop.Data.Entities
@rendermode InteractiveServer
<h3>CustomerEdit</h3>

<MudTextField @bind-Value="Customer.CustomerName" Label="Customer Name" />
<MudTextField @bind-Value="Customer.CustomerId" Label="Customer Identifiction" />
<MudButton Color="Color.Primary" Variant="Variant.Filled"  @onclick="SaveCustomer">Save</MudButton>


@code {

    [Parameter]
    public Guid CustomerId { get; set; }

    private CustomerDesignServices Customer { get; set; } = new CustomerDesignServices();

    protected override async Task OnInitializedAsync()
    {

        await Task.Delay(1000);
        Customer = new CustomerDesignServices
        {
                CustomerId = Guid.NewGuid(),
                CustomerName = "John Doe",
                InvoiceId = Guid.NewGuid(),
        };

    }
    private async Task SaveCustomer()
    {
        await Task.Delay(1000);
        Console.WriteLine($"Saved Customer: {Customer.CustomerName}");
    }
}
