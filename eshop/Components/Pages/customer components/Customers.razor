@page "/customers"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Routing
@using eshop.Components.Pages.invoice_components
@using eshop.Data.Entities
@using eshop.Components.Pages.customer_components
@inject ICustomerServices _customerService
@inject IInvoiceServices _invoiceService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
<h3>Customers</h3>


<MudTable Items="Cust" Dense="@dense" Bordered="@bordered" Striped="@striped" Hover="@hover" Loading="@_loading" LoadingProgressColor="Color.Info">
     <ToolBarContent>
         <MudSpacer />
        <MudButton Color="Color.Primary" 
        Variant="Variant.Filled" 
        StartIcon="@Icons.Material.Filled.Add"
         @onclick="NavigateToAddCustomer">
             Add Customer
     </MudButton>

    </ToolBarContent>
    <HeaderContent>
        <MudTh>CustomerId</MudTh>
        <MudTh>CustomerName</MudTh>
        <MudTh>CustomerPhone</MudTh>
        <MudTh>CustomerAddress</MudTh>
        <MudTh>CustomerEmail</MudTh>
        <MudTh>Invoices</MudTh>
        <MudTh>Operations</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="id">@context.Id</MudTd>
        <MudTd DataLabel="name">@context.CustomerName</MudTd>
        <MudTd DataLabel="phone">@context.CustomerPhone</MudTd>
        <MudTd DataLabel="email">@context.CustomerEmail</MudTd>
        <MudTd DataLabel="address">@context.CustomerAddress</MudTd>
        <MudTd DataLabel="Invoices">
            <MudButton color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.List"
                       OnClick="() => NavigateToInvoices(context)">
                View Invoices
            </MudButton>
        </MudTd>
        <MudTd>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="() => OpenEditDialog(context)" />
            <MudButton Color="Color.Error" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="()=>Deletecustomer(context)" />
        </MudTd>
    </RowTemplate>
</MudTable>
<style>
    .my-custom-class {
        backdrop-filter: blur(10px);
    }
</style>

<div class="d-flex flex-wrap mt-4">
    <MudSwitch @bind-Value="hover" Color="Color.Primary">Hover</MudSwitch>
    <MudSwitch @bind-Value="dense" Color="Color.Secondary">Dense</MudSwitch>
    <MudSwitch @bind-Value="striped" Color="Color.Tertiary">Striped</MudSwitch>
    <MudSwitch @bind-Value="bordered" Color="Color.Warning">Bordered</MudSwitch>
    <MudSpacer />
    <div style="min-width:200px;">
        <MudText Class="align-self-center d-inline">Selected1</MudText>
    </div>
</div>

@code {
    private bool dense = true;
    private bool hover = true;
    private bool striped = false;
    private bool bordered = false;
    private bool _loading = false;

    private List<Customer> Cust { get; set; } = new();
    private List<Invoice> Invo { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        Cust = await _customerService.GetCustomer();
        _loading = false;
    }

    private async Task NavigateToAddCustomer()
    {
        var options = new DialogOptions {  
            CloseButton = true,  
            MaxWidth = MaxWidth.Medium,  
            FullWidth = true,  
            Position = DialogPosition.Center,  
            NoHeader = true,  
            BackdropClick = true,  
            CloseOnEscapeKey = true , 
            BackgroundClass = "my-custom-class"
        };
        var dialog = DialogService.Show<CustomerEdit>("Add Customer", options);
        var result = await dialog.Result;
        if(result.Data != null) // Check if the dialog returned data  
        {  
            Cust = await _customerService.GetCustomer();  
            StateHasChanged();  
        }
    }

    private async Task OpenEditDialog(Customer customer)  
    {  
            var parameters = new DialogParameters { ["Id"] = customer.Id };
            var options = new DialogOptions {  
                CloseButton = true,  
                MaxWidth = MaxWidth.Medium,  
                FullWidth = true,  
                Position = DialogPosition.Center,  
                NoHeader = true,  
                BackdropClick = true,  
                CloseOnEscapeKey = true , 
                BackgroundClass = "my-custom-class"
            };
            var dialog = DialogService.Show<CustomerEdit>("Edit Customer", parameters, options);  
            var result = await dialog.Result;  

            // Optionally refresh the list if changes were made  
            if (result.Data != null) // Check if the dialog returned data  
            {  
                Cust = await _customerService.GetCustomer();  
                StateHasChanged();  
            }  
    }  

    private async Task NavigateToInvoices(Customer customer)  
    {
        var invoices = await _invoiceService.GetInvoicesByCustomerId(customer.Id);
        if (invoices != null && invoices.Any())
        {
            var parameters = new DialogParameters { ["Invoices"] = invoices };
            var options = new DialogOptions {  
                CloseButton = true,  
                MaxWidth = MaxWidth.Medium,  
                FullWidth = true,  
                Position = DialogPosition.Center,  
                NoHeader = true,  
                BackdropClick = true,  
                CloseOnEscapeKey = true , 
                BackgroundClass = "my-custom-class"
            };
            var dialog = DialogService.Show<Invoices>("Customer Invoices", parameters, options);
            var result = await dialog.Result;
        }
        else
        {
            Snackbar.Add("No invoices available for this customer.", Severity.Warning);
        }
    }

    public async Task Deletecustomer(Customer customer)
    {
        await _customerService.DeleteAsync(customer);
        Cust.Remove(customer);
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
        Snackbar.Add("Customer Deleted Successfully", Severity.Success);
    }
}