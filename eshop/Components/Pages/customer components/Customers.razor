@page "/customers"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Routing
@using eshop.Data.Entities
@using eshop.Components.Pages.customer_components
@inject ICustomerServices _customerService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
<h3>Customers</h3>


<MudTable Items="Cust" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info">
     <ToolBarContent>
         <MudSpacer />
        <MudButton Color="Color.Primary" 
        Variant="Variant.Filled" 
        StartIcon="@Icons.Material.Filled.Add"
         @onclick="NavigateToAddCustomer">
             Add Customer
     </MudButton>

    </ToolBarContent>
    <HeaderContent>
        <MudTh>CustomerId</MudTh>
        <MudTh>CustomerName</MudTh>
        <MudTh>CustomerPhone</MudTh>
        <MudTh>CustomerAddress</MudTh>
        <MudTh>CustomerEmail</MudTh>
        <MudTh>Invoices</MudTh>
        <MudTh>Operations</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="id">@context.Id</MudTd>
        <MudTd DataLabel="name">@context.CustomerName</MudTd>
        <MudTd DataLabel="phone">@context.CustomerPhone</MudTd>
        <MudTd DataLabel="email">@context.CustomerEmail</MudTd>
        <MudTd DataLabel="address">@context.CustomerAddress</MudTd>
        <MudTd DataLabel="Invoices">
            @if (context.Invoices != null && context.Invoices.Any())
            {
                <MudSelect T="Guid" Label="Invoices" Dense="true" Disabled="false">
                    @foreach (var invoice in context.Invoices)
                    {
                        <MudSelectItem Value="@invoice.Id">@invoice.Id</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudText Color="Color.Secondary" Typo="Typo.caption">No invoices</MudText>
            }
        </MudTd>
        <MudTd>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Edit" OnClick="()=>NavigateToAddCustomer(context)" />
            <MudButton Color="Color.Error" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="()=>Deletecustomer(context)" />
        </MudTd>
    </RowTemplate>
</MudTable>


@code {

    private bool _loading = false;

    private List<Customer> Cust { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        Cust = await _customerService.GetCustomer();
        _loading = false;
    }

    public void NavigateToAddCustomer()
    {
        NavigationManager.NavigateTo("/customersedit");
    }

    public void NavigateToAddCustomer(Customer customer)
    {
        NavigationManager.NavigateTo($"/customersedit/{customer.Id}");
    }

    public async Task Deletecustomer(Customer customer)
    {
        await _customerService.DeleteAsync(customer);
        Cust.Remove(customer);
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
        Snackbar.Add("Customer Deleted Successfully", Severity.Success);
    }
}