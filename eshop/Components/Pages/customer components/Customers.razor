@page "/customers"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Routing
@inject ICustomerServices _customerService
@inject NavigationManager NavigationManager
@using eshop.Data.Entities
@using eshop.Components.Pages.customer_components
<h3>Customers</h3>


<MudTable Items="Cust" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info">
     <ToolBarContent>
         <MudSpacer />
        <MudButton Color="Color.Primary" 
        Variant="Variant.Filled" 
        StartIcon="@Icons.Material.Filled.Add"
         @onclick="NavigateToAddCustomer">
             Add Customer
     </MudButton>

    </ToolBarContent>
    <HeaderContent>
        <MudTh>CustomerId</MudTh>
        <MudTh>CustomerName</MudTh>
        <MudTh>CustomerPhone</MudTh>
        <MudTh>CustomerAddress</MudTh>
        <MudTh>CustomerEmail</MudTh>
        <MudTh>InvoiceId</MudTh>
        <MudTh>Operations</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="id">@context.Id</MudTd>
        <MudTd DataLabel="name">@context.CustomerName</MudTd>
        <MudTd DataLabel="phone">@context.CustomerPhone</MudTd>
        <MudTd DataLabel="email">@context.CustomerEmail</MudTd>
        <MudTd DataLabel="address">@context.CustomerAddress</MudTd>
        <MudTd DataLabel="InvoiceId">@context.Invoices</MudTd>
        <MudTd>

            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Edit" OnClick="NavigateToAddCustomer" />

            <MudButton Color="Color.Error" Variant="Variant.Filled" 
            StartIcon="@Icons.Material.Filled.Delete"
            OnClick="()=>Deletecustomer(context)"/>

        </MudTd>
    </RowTemplate>
</MudTable>


@code {

    private bool _loading = false;

    public List<Customer> Cust { get; set; } = new List<Customer>();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await Task.Delay(1000);
        Cust = _customerService.GetCustomer();
        _loading = false;

    }

    public void NavigateToAddCustomer()
    {
        NavigationManager.NavigateTo("/customersedit");
    }
    public void Deletecustomer(Customer customer)
    {
        // Simulate deleting the customer
        Cust.Remove(customer);
    }
}